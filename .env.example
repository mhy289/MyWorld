# ============================================
# 前端部署环境变量示例
# 复制本文件为 .env 后按需填写（.env.local 已被 git 忽略，也可用 .env.production 等）
# 所有 VITE_* 变量在构建时注入前端，修改后需重新构建生效
# ============================================

# ----- 后端链接（部署时必填项）-----
# 本地后端根地址（不带 /api），例如 http://192.168.1.10:8080
# 设置后：本地接口请求将直接发往该地址的 /api/*，同时作为开发代理的转发目标
# 留空时：生产环境默认同源（/api），开发环境默认代理到 http://localhost:8080
VITE_BACKEND_URL=

# ----- 本地接口开关 -----
# true  = 启用本地接口（/api/*），默认
# false = 关闭本地接口，所有数据改为从对外公开接口获取（投票等写操作将不可用）
VITE_ENABLE_LOCAL_API=true

# ----- 对外接口开关 -----
# true  = 本地接口连不上时自动回退到对外公开接口（/public/*），默认
# false = 不回退，本地接口连不上时保持错误提示
VITE_ENABLE_PUBLIC_API=true

# ----- 可选变量（默认已够用，一般无需修改）-----

# 本地接口 base URL（已设置 VITE_BACKEND_URL 时无需填写；两者都填时以此为准）
# 例：/api 或 https://backend.example.com/api
VITE_API_BASE_URL=

# 对外接口 base URL（默认空 = 同源 /public/*；对外后端异地部署时填完整地址）
# 例：https://api.example.com
VITE_PUBLIC_API_BASE_URL=
