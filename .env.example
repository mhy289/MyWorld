# ============================================
# 前端部署环境变量模板（二选一）
# 复制本文件为 .env / .env.production / .env.local 后按实际部署形态填写
# 所有 VITE_* 变量在构建时注入前端，修改后需重新构建生效
# ============================================

# ============================================
# 方案 A：同源部署（前后端同一服务器 / 同域名）
# ============================================
# 适用：Nginx 托管前端 dist/ 静态文件 + 反代 /api、/public 到本机 Go 后端(127.0.0.1:8080)
# 特点：单域名、无跨域、静态资源由 Nginx 缓存，个人站首选
VITE_API_MODE=same-origin

# 后端根地址（不带 /api）。
#   与前端同域名（Nginx 反代了 /api）→ 留空
#   后端独立端口且未配反代         → 填 http://127.0.0.1:8080
VITE_BACKEND_URL=

# 同源模式显式 base URL（一般留空；设了 VITE_BACKEND_URL 则无需再设，两者都填时以此为准）
VITE_API_BASE_URL=

# 同源模式用不到，留空即可
VITE_PUBLIC_API_BASE_URL=

# ============================================
# 方案 B：分离部署（前后端不同服务器）
# ============================================
# 适用：前端静态站（COS/CDN/GitHub Pages 等任意静态托管）+ 后端独立域名
# 特点：所有请求跨域走 /public/*（读写均可），CORS 白名单需包含前端域名
# 切换方法：把上面的 VITE_API_MODE 改为下面这一行，并填 VITE_PUBLIC_API_BASE_URL
# VITE_API_MODE=separate
# 后端对外域名（不带 /public），必填
# VITE_PUBLIC_API_BASE_URL=https://api.mhy.ink
# 以下两项仅 same-origin 模式生效，分离模式无需填写，保持留空即可
# VITE_BACKEND_URL=
# VITE_API_BASE_URL=

# ============================================
# 旧开关兼容（一般不用动）
# ============================================
# 未设置 VITE_API_MODE 时按 VITE_ENABLE_LOCAL_API 推断：true → same-origin，false → separate
# VITE_ENABLE_LOCAL_API=true
