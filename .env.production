# ============================================
# 生产环境构建配置（Vite 构建 production 时自动读取，随仓库提交，CI 部署生效）
# ============================================

# 本地后端根地址（不带 /api）
# 前端与后端分离部署时必填：指向后端真实域名，否则 /api 会发到前端同源域名被 CDN 拦截返回 405
VITE_BACKEND_URL=https://api.mhy.ink

# 本地接口 base URL（已设置 VITE_BACKEND_URL 时无需再设；若两者都填，以 VITE_API_BASE_URL 为准）
VITE_API_BASE_URL=https://api.mhy.ink/api

# 对外公开接口 base URL（默认同源 /public/*；后端异地部署时填完整地址）
VITE_PUBLIC_API_BASE_URL=https://api.mhy.ink

# 本地接口开关
VITE_ENABLE_LOCAL_API=true

# 对外接口开关
VITE_ENABLE_PUBLIC_API=true
