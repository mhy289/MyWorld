# ============================================
# 生产环境构建配置（参考样例，供部署时对照填写；当前不用于实际部署）
# Vite 构建 production 时自动读取，随仓库提交，CI 部署生效
# ============================================

# ----- 部署模式（二选一）-----
# same-origin：前后端同服务器/同域名（推荐个人站：单域名、无跨域、Nginx 缓存静态资源）
# separate：前后端分离（前端静态站 + 后端独立域名，如 https://api.mhy.ink）
# 以下默认 same-origin；若走分离部署，改为 separate 并填写 VITE_PUBLIC_API_BASE_URL
VITE_API_MODE=same-origin

# ----- 同源模式（默认）-----
# 本地后端根地址（不带 /api）；与前端同域名时留空（Nginx 反代 /api 即可）
VITE_BACKEND_URL=

# 本地接口 base URL（已设置 VITE_BACKEND_URL 时无需再设；两者都填时以此为准）
VITE_API_BASE_URL=

# ----- 分离部署示例（切换 VITE_API_MODE=separate 时使用）-----
# VITE_BACKEND_URL=https://api.mhy.ink
# VITE_API_BASE_URL=https://api.mhy.ink/api
# VITE_PUBLIC_API_BASE_URL=https://api.mhy.ink
VITE_PUBLIC_API_BASE_URL=
